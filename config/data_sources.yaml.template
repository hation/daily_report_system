# 通用数据源配置
common:
  # 时间处理
  time_handling:
    default_timezone: "Asia/Shanghai"
    input_formats:
      - "%Y-%m-%d %H:%M:%S"
      - "%Y%m%d_%H%M%S"
      - "%Y-%m-%dT%H:%M:%S"
    output_format: "%Y-%m-%d %H:%M:%S"
    
  # 数据验证
  validation:
    required_fields: ["content", "time"]
    time_range_check: true
    content_sanity_check: true
    
  # 错误处理
  error_handling:
    max_retries: 3
    retry_delay: 1  # 秒
    skip_on_error: false  # 出错时跳过还是停止